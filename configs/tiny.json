{
    "model_name": "magicasualLLM",
  
    "vocab_size": 8192,
    "max_seq_len": 256,
  
    "hidden_size": 384,
    "num_layers": 6,
  
    "num_attention_heads": 6,
    "num_key_value_heads": 2,
    "head_dim": 64,
  
    "intermediate_size": 1024,
  
    "rms_norm_eps": 1e-5,
    "rope_theta": 10000.0,
  
    "tie_word_embeddings": true,
  
    "dropout": 0.0,
  
    "optimizer": "sgd",
    "learning_rate": 0.01,
    "momentum": 0.9,
    "batch_size": 2,
    "gradient_accumulation_steps": 16,
  
    "max_steps": 10000,
    "warmup_steps": 200,
  
    "dtype": "float16"
  }
